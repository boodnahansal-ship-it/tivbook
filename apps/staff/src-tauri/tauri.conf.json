{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TiVBook Staff",
  "version": "0.1.0",
  "identifier": "mu.tivegas.tivbook.staff",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "TiVBook Staff — Ti Vegas", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600, "maximized": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Funworld Co Ltd — Ti Vegas",
    "shortDescription": "TiVBook staff software (Admin, Cashier, Floor, Front Desk)",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "perMachine", "displayLanguageSelector": false, "languages": ["English", "French"] },
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
